# ---------------------------------------------------------------
# VERİTABANI — PostgreSQL (Neon)
# ---------------------------------------------------------------
# Şema PostgreSQL'e göre üretilir (prisma/schema.prisma). Adres
# postgresql:// ile başlamalıdır; SQLite ("file:...") DESTEKLENMEZ —
# Prisma sağlayıcı uyuşmazlığında istemciyi hiç kurmaz.
#
# Neon (ücretsiz): https://neon.tech -> Connection string
# Sunucusuz ortamda havuzlanmış (pooled) adresi kullanın.
DATABASE_URL="postgresql://kullanici:sifre@ep-xxx-pooler.eu-central-1.aws.neon.tech/pirogastro?sslmode=require"
#
# Geliştirme için AYRI bir veritabanı (ya da Neon branch) kullanın;
# yerel testler yayın verisine yazmasın.
#
# Tablolar Vercel derlemesinde otomatik oluşur (scripts/yayin-hazirla.mjs
# -> prisma migrate deploy). Elle çalıştırmak için: npm run db:migrate
#
# Neon'un havuzlanmış ("-pooler") adresi PgBouncer üzerinden geçer ve
# migration'ın kullandığı oturum kilidini desteklemez. Havuzlanmış adres
# kullanıyorsanız, migration için havuzlanmamış adresi de ekleyin:
# DIRECT_DATABASE_URL="postgresql://kullanici:sifre@ep-xxx.eu-central-1.aws.neon.tech/pirogastro?sslmode=require"

# ---------------------------------------------------------------
# OTOMATİK ÇEVİRİ  (biri yeterli, ikisi de boşsa çeviri çalışmaz)
# ---------------------------------------------------------------
# DeepL — https://www.deepl.com/pro-api  (ücretsiz katman: ayda 500.000 karakter)
# Ücretsiz anahtarlar ":fx" ile biter, sistem bunu kendisi algılar.
# DEEPL_API_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx"

# Google Cloud Translation v2 — https://console.cloud.google.com
# GOOGLE_TRANSLATE_API_KEY="AIza..."

# ---------------------------------------------------------------
# SÜPER ADMIN GİRİŞİ  (zorunlu)
# ---------------------------------------------------------------
# /{dil}/admin ve /api/admin yollarını korur.
# Tanımlı değilse: geliştirmede serbest, YAYINDA panel tamamen kapalıdır.
# Vercel'de: Settings -> Environment Variables -> ADMIN_SIFRE
ADMIN_SIFRE="guclu-bir-sifre-yazin"

# ---------------------------------------------------------------
# ÖDEME — STRIPE
# ---------------------------------------------------------------
# Swish, Klarna, Apple Pay, Google Pay, Visa, Mastercard ve AMEX'in
# tamamı Stripe Checkout üzerinden karşılanır.
#
# 1) https://dashboard.stripe.com hesabı açın (İsveç tüzel kişiliği ile)
# 2) Developers -> API keys -> Secret key
# 3) Settings -> Payment methods: Swish ve Klarna'yı ETKİNLEŞTİRİN
#    (Klarna onay gerektirir, Swish SEK ve İsveç tüzel kişiliği ister)
# Tanımlı değilse kartlı ödeme başlatılmaz — sistem "varmış gibi" davranmaz.
STRIPE_SECRET_KEY="sk_test_..."

# Webhook imzası — ödemenin alındığına dair TEK güvenilir kaynak budur.
# Stripe -> Developers -> Webhooks -> Add endpoint
#   URL:      https://SITENIZ/api/odeme/webhook
#   Olaylar:  checkout.session.completed
#             checkout.session.async_payment_succeeded
#             checkout.session.async_payment_failed
#             checkout.session.expired
STRIPE_WEBHOOK_SECRET="whsec_..."

# Yalnızca belirli yöntemleri sunmak isterseniz (Klarna onayı beklerken vb.):
# STRIPE_YONTEMLER="card,swish"

# Stripe'ın dönüş adreslerini üretebilmesi için site kökü.
# Vercel'de boş bırakılabilir; istek başlıklarından çözülür.
# NEXT_PUBLIC_SITE_URL="https://piro-gastro.vercel.app"

# ---------------------------------------------------------------
# ÖDEME MODU
# ---------------------------------------------------------------
# demo → Sağlayıcı çağrılmaz. Ödeme onaylanmış SAYILIR; sipariş, makbuz,
#        muhasebe ve Süper Admin zinciri baştan sona çalışır. Müşteriye her
#        ekranda "gerçek tahsilat yapılmadı" uyarısı gösterilir.
# live → Gerçek Stripe Checkout (Swish, Klarna, kart, Apple/Google Pay).
#
# Tanımlı değilse: geliştirmede demo, YAYINDA ödeme kapalı.
# Yayında demo istiyorsanız açıkça yazın — kendiliğinden açılmaz.
# ODEME_MODU="demo"

# ---------------------------------------------------------------
# CANLI DESTEĞİN DIŞ VİTRİNE GÖMÜLMESİ  (Shopify)
# ---------------------------------------------------------------
# Mağaza Shopify'a taşındığında sohbet burada kalır; Shopify vitrini
# /sohbet-gomulu.js dosyasını yükleyip /api/chat/* uçlarını çağırır.
# Tarayıcının bu isteğe izin vermesi için köken burada YAZILI olmalıdır.
#
# Virgülle ayrılır, sonda eğik çizgi olmaz. Boşsa dış erişim kapalıdır
# ("*" hiçbir durumda kullanılmaz — bu uçlar veritabanına kayıt açar).
# SOHBET_KAYNAKLARI="https://pirogastro.myshopify.com,https://pirogastro.se"
