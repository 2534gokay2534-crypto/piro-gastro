// Piro Gastro Center AB — çok dilli katalog veritabanı
//
// Veritabani: PostgreSQL (Neon). Hem yayin hem gelistirme ayni saglayiciyi
// kullanir — Prisma sema basina tek saglayici destekler ve iki lehcede ayri
// migration tutmak kacinilmaz olarak birbirinden ayrisir.
// Gelistirme icin Neon'da ayri bir veritabani (ya da branch) kullanin.
//
// Çeviri tasarımı: her metin alanı AYRI SATIRDA, dil koduyla tutulur.
// Yeni dil eklemek ŞEMA DEĞİŞİKLİĞİ GEREKTİRMEZ — Language tablosuna bir
// satır eklenir, çeviri satırları o kodla yazılır.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------
// DİLLER
// ---------------------------------------------------------------

model Language {
  code     String  @id // sv, en, tr, de, ru…
  name     String // Svenska, Deutsch…
  locale   String // sv-SE
  currency String  @default("EUR")
  rate     Float   @default(1)
  enabled  Boolean @default(true)
  sort     Int     @default(0)

  /// Çevirinin üretileceği kaynak dil
  sourceCode String @default("en")

  createdAt DateTime @default(now())

  productTexts  ProductText[]
  specTexts     SpecText[]
  categoryTexts CategoryText[]
}

// ---------------------------------------------------------------
// KATALOG
// ---------------------------------------------------------------

model Category {
  id       String     @id
  slug     String     @unique
  icon     String?
  sort     Int        @default(0)
  parentId String?
  parent   Category?  @relation("Tree", fields: [parentId], references: [id])
  children Category[] @relation("Tree")

  texts       CategoryText[]
  products    Product[]      @relation("Cat")
  subProducts Product[]      @relation("Sub")

  @@index([parentId])
  @@index([sort])
}

model CategoryText {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  langCode   String
  lang       Language @relation(fields: [langCode], references: [code], onDelete: Cascade)

  name String
  desc String?

  /// source | manual | machine
  origin    String   @default("manual")
  updatedAt DateTime @updatedAt

  @@unique([categoryId, langCode])
  @@index([langCode])
}

model Brand {
  id       String    @id
  slug     String    @unique
  name     String
  country  String?
  products Product[]
}

model Product {
  id   String @id
  sku  String @unique
  slug String @unique

  categoryId String
  category   Category  @relation("Cat", fields: [categoryId], references: [id])
  subId      String?
  sub        Category? @relation("Sub", fields: [subId], references: [id])
  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id])

  priceCents Int     @default(0)
  currency   String  @default("EUR")
  stock      Int     @default(0)
  threshold  Int     @default(0)
  onRequest  Boolean @default(false)
  leadDays   Int     @default(5)
  warranty   Int     @default(24)

  hidden   Boolean @default(false)
  featured Boolean @default(false)
  badge    String?

  campaignOn      Boolean @default(false)
  campaignPercent Int     @default(0)

  sold Int @default(0)

  /// Listeleme sırası: büyük/ana ürün 1000'e, tamamlayıcı küçük 0'a yakın.
  /// scripts/urun-sirala.mjs hesaplar; mağaza ve yönetici paneli aynı sayıyı okur.
  sortRank Int @default(500)

  /// Alış maliyeti — kâr/zarar hesabı için (kuruş)
  costCents  Int     @default(0)
  supplierId String?

  // ölçüler (mm)
  dimW     Int?
  dimD     Int?
  dimH     Int?
  weightKg Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  texts  ProductText[]
  images ProductImage[]
  specs  Spec[]

  @@index([categoryId])
  @@index([subId])
  @@index([brandId])
  @@index([hidden])
}

/// Ürünün bir dildeki metinleri. Dil başına tek satır.
model ProductText {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  langCode  String
  lang      Language @relation(fields: [langCode], references: [code], onDelete: Cascade)

  name String
  desc String?

  /// source  = tedarikçiden geldi (özgün metin)
  /// manual  = Süper Admin elle yazdı / düzeltti
  /// machine = otomatik çeviriyle üretildi
  origin String @default("machine")

  /// Elle düzeltildiyse otomatik çeviri ÜZERİNE YAZMAZ
  locked Boolean @default(false)

  translatedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([productId, langCode])
  @@index([langCode])
  @@index([origin])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sort      Int     @default(0)

  @@index([productId])
}

/// Teknik özellik satırı — metni dile göre SpecText'te.
model Spec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sort      Int     @default(0)

  texts SpecText[]

  @@index([productId])
}

model SpecText {
  id       String   @id @default(cuid())
  specId   String
  spec     Spec     @relation(fields: [specId], references: [id], onDelete: Cascade)
  langCode String
  lang     Language @relation(fields: [langCode], references: [code], onDelete: Cascade)

  label String
  value String

  origin       String    @default("machine")
  locked       Boolean   @default(false)
  translatedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([specId, langCode])
  @@index([langCode])
}

// ---------------------------------------------------------------
// ÇEVİRİ ÖNBELLEĞİ
// Aynı metin bir daha çevrilmesin diye kaynak metnin özeti saklanır.
// Binlerce üründe tekrar eden etiketler tek çeviriyle karşılanır.
// ---------------------------------------------------------------

model TranslationCache {
  id       String @id @default(cuid())
  /// kaynak metnin sha256 özeti
  hash     String
  fromCode String
  toCode   String
  source   String
  target   String
  provider String @default("deepl")

  createdAt DateTime @default(now())

  @@unique([hash, fromCode, toCode])
  @@index([toCode])
}

/// Çeviri işlerinin kaydı — kaç çağrı, kaç karakter, kaç önbellek isabeti.
model TranslationRun {
  id         String    @id @default(cuid())
  langCode   String
  provider   String
  items      Int       @default(0)
  chars      Int       @default(0)
  cacheHits  Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  note       String?
}

// ---------------------------------------------------------------
// SİSTEM
// ---------------------------------------------------------------

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------
// CANLI SOHBET
// Ziyaretçi mesajları ve yönetici yanıtları. Mağaza tarafı bu
// tablolara BAĞLI DEĞİLDİR; veritabanı yoksa sohbet penceresi
// "mesaj bırak" kipine düşer, site normal çalışmayı sürdürür.
// ---------------------------------------------------------------

model ChatSession {
  id          String    @id @default(cuid())
  visitorId   String
  name        String?
  email       String?
  phone       String?
  lang        String    @default("sv")
  page        String?
  /// open = açık · waiting = beklemede (yanıt bekliyor) · closed = kapatıldı
  status      String    @default("open")
  mode        String    @default("live") // live | offline
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  agentSeenAt DateTime?

  messages ChatMessage[]

  @@index([status, updatedAt])
  @@index([visitorId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  sender    String // visitor | agent | system
  body      String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ===============================================================
// SÜPER ADMIN — TİCARİ MODELLER
// Katalog tabloları (Product, Category, Brand) DEĞİŞTİRİLMEDİ.
// Buradaki tablolar yalnızca yönetim paneli için eklendi; mağaza
// tarafı bunlara bağlı değildir.
// ===============================================================

model Customer {
  id      String  @id @default(cuid())
  name    String
  email   String?
  phone   String?
  company String?
  orgNr   String? // Org.nr / vergi no
  vatNr   String?

  address String?
  zip     String?
  city    String?
  country String  @default("SE")

  /// retail | business
  type  String  @default("business")
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  orders Order[]

  @@index([email])
  @@index([name])
}

model Order {
  id     String @id @default(cuid())
  number String @unique // PG-2026-0001

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// new | paid | packing | shipped | delivered | cancelled | refunded
  status    String @default("new")
  /// card | invoice | swish | bank | cash
  payMethod String @default("invoice")

  currency String @default("SEK")

  subtotalCents Int @default(0)
  vatCents      Int @default(0)
  shipCents     Int @default(0)
  discountCents Int @default(0)
  totalCents    Int @default(0)
  costCents     Int @default(0) // maliyet — kâr hesabı için

  couponCode String?
  note       String?

  /// Ödeme sağlayıcı izleri (Stripe oturumu / ödeme niyeti)
  provider    String? // stripe
  providerRef String? // cs_... oturum kimliği
  paymentRef  String? // pi_... ödeme kimliği
  paidMethod  String? // card | swish | klarna | apple_pay | google_pay

  shipName String?
  shipAddr String?
  shipZip  String?
  shipCity String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  paidAt     DateTime?
  shippedAt  DateTime?
  refundedAt DateTime?

  items OrderItem[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([providerRef])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  sku       String
  name      String
  /// Sipariş anındaki ayırt edici özellikler (renk, ölçü, kapasite…).
  /// Katalog sonradan değişse bile makbuz ne alındığını gösterir.
  variant   String?

  qty            Int @default(1)
  unitPriceCents Int @default(0)
  unitCostCents  Int @default(0)
  vatRate        Int @default(25) // %
  lineTotalCents Int @default(0)

  @@index([orderId])
  @@index([productId])
}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  contact String?
  email   String?
  phone   String?
  country String  @default("SE")
  address String?
  notes   String?

  /// Ortalama tedarik süresi (gün)
  leadDays Int @default(14)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([name])
}

model Coupon {
  id   String @id @default(cuid())
  code String @unique

  /// percent | amount
  kind  String @default("percent")
  value Int    @default(0) // % veya kuruş

  minTotalCents Int @default(0)
  usageLimit    Int @default(0) // 0 = sınırsız
  usedCount     Int @default(0)

  startsAt DateTime?
  endsAt   DateTime?
  active   Boolean   @default(true)

  note      String?
  createdAt DateTime @default(now())

  @@index([active])
}

model StockMovement {
  id        String @id @default(cuid())
  productId String
  sku       String

  delta  Int // + giriş, − çıkış
  before Int @default(0)
  after  Int @default(0)

  /// sale | purchase | correction | return | import
  reason String  @default("correction")
  note   String?
  actor  String  @default("super-admin")

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

model Expense {
  id String @id @default(cuid())

  /// income | expense
  kind     String @default("expense")
  /// kira, maaş, nakliye, reklam, satış…
  category String @default("genel")

  description String
  amountCents Int    @default(0)
  vatCents    Int    @default(0)
  currency    String @default("SEK")

  /// card | invoice | swish | bank | cash
  method String @default("bank")

  supplierId String?
  date       DateTime @default(now())
  note       String?

  createdAt DateTime @default(now())

  @@index([kind, date])
  @@index([date])
}

model AdminUser {
  id    String  @id @default(cuid())
  email String  @unique
  name  String
  phone String?

  /// Basit özet (sha256). Giriş kapısı ADMIN_SIFRE ile çalışır;
  /// bu alan ileride tam oturum sistemi için hazır bekler.
  passHash String?

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([roleId])
}

model Role {
  id   String @id @default(cuid())
  name String @unique

  /// Yetki anahtarları, virgülle ayrılmış: "urun.duzenle,siparis.gor"
  perms String @default("")

  note      String?
  createdAt DateTime @default(now())

  users AdminUser[]
}

model Backup {
  id    String @id @default(cuid())
  label String

  /// katalog | tam
  kind String @default("katalog")

  products Int @default(0)
  orders   Int @default(0)
  bytes    Int @default(0)

  actor     String   @default("super-admin")
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Kurumsal fatura ile ödeme başvurusu.
/// Başvuru gelir, Süper Admin onaylayana kadar o firma fatura ile ödeyemez.
model InvoiceApplication {
  id String @id @default(cuid())

  company String
  orgNr   String
  vatNr   String?

  contact String // yetkili kişi
  email   String
  phone   String

  billAddr String
  billZip  String
  billCity String
  country  String @default("SE")

  note String?

  /// pending | approved | rejected
  status    String    @default("pending")
  decidedBy String?
  decidedAt DateTime?
  decision  String? // onay/red gerekçesi

  /// Onaylıysa bu limite kadar faturalı sipariş verilebilir (cent, 0 = sınırsız)
  creditLimitCents Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([orgNr])
  @@index([email])
}
