// Piro Gastro Center AB — çok dilli katalog veritabanı
//
// Geliştirme: SQLite (kurulum gerektirmez, dev.db dosyası)
// Yayın     : PostgreSQL — provider'ı "postgresql" yapıp DATABASE_URL vermek yeterli
//
// Çeviri tasarımı: her metin alanı AYRI SATIRDA, dil koduyla tutulur.
// Yeni dil eklemek ŞEMA DEĞİŞİKLİĞİ GEREKTİRMEZ — Language tablosuna bir
// satır eklenir, çeviri satırları o kodla yazılır.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------
// DİLLER
// ---------------------------------------------------------------

model Language {
  code     String  @id // sv, en, tr, de, ru…
  name     String // Svenska, Deutsch…
  locale   String // sv-SE
  currency String  @default("EUR")
  rate     Float   @default(1)
  enabled  Boolean @default(true)
  sort     Int     @default(0)

  /// Çevirinin üretileceği kaynak dil
  sourceCode String @default("en")

  createdAt DateTime @default(now())

  productTexts  ProductText[]
  specTexts     SpecText[]
  categoryTexts CategoryText[]
}

// ---------------------------------------------------------------
// KATALOG
// ---------------------------------------------------------------

model Category {
  id       String     @id
  slug     String     @unique
  icon     String?
  sort     Int        @default(0)
  parentId String?
  parent   Category?  @relation("Tree", fields: [parentId], references: [id])
  children Category[] @relation("Tree")

  texts       CategoryText[]
  products    Product[]      @relation("Cat")
  subProducts Product[]      @relation("Sub")

  @@index([parentId])
  @@index([sort])
}

model CategoryText {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  langCode   String
  lang       Language @relation(fields: [langCode], references: [code], onDelete: Cascade)

  name String
  desc String?

  /// source | manual | machine
  origin    String   @default("manual")
  updatedAt DateTime @updatedAt

  @@unique([categoryId, langCode])
  @@index([langCode])
}

model Brand {
  id       String    @id
  slug     String    @unique
  name     String
  country  String?
  products Product[]
}

model Product {
  id   String @id
  sku  String @unique
  slug String @unique

  categoryId String
  category   Category  @relation("Cat", fields: [categoryId], references: [id])
  subId      String?
  sub        Category? @relation("Sub", fields: [subId], references: [id])
  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id])

  priceCents Int     @default(0)
  currency   String  @default("EUR")
  stock      Int     @default(0)
  threshold  Int     @default(0)
  onRequest  Boolean @default(false)
  leadDays   Int     @default(5)
  warranty   Int     @default(24)

  hidden   Boolean @default(false)
  featured Boolean @default(false)
  badge    String?

  campaignOn      Boolean @default(false)
  campaignPercent Int     @default(0)

  sold Int @default(0)

  // ölçüler (mm)
  dimW     Int?
  dimD     Int?
  dimH     Int?
  weightKg Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  texts  ProductText[]
  images ProductImage[]
  specs  Spec[]

  @@index([categoryId])
  @@index([subId])
  @@index([brandId])
  @@index([hidden])
}

/// Ürünün bir dildeki metinleri. Dil başına tek satır.
model ProductText {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  langCode  String
  lang      Language @relation(fields: [langCode], references: [code], onDelete: Cascade)

  name String
  desc String?

  /// source  = tedarikçiden geldi (özgün metin)
  /// manual  = Süper Admin elle yazdı / düzeltti
  /// machine = otomatik çeviriyle üretildi
  origin String @default("machine")

  /// Elle düzeltildiyse otomatik çeviri ÜZERİNE YAZMAZ
  locked Boolean @default(false)

  translatedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([productId, langCode])
  @@index([langCode])
  @@index([origin])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sort      Int     @default(0)

  @@index([productId])
}

/// Teknik özellik satırı — metni dile göre SpecText'te.
model Spec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sort      Int     @default(0)

  texts SpecText[]

  @@index([productId])
}

model SpecText {
  id       String   @id @default(cuid())
  specId   String
  spec     Spec     @relation(fields: [specId], references: [id], onDelete: Cascade)
  langCode String
  lang     Language @relation(fields: [langCode], references: [code], onDelete: Cascade)

  label String
  value String

  origin       String    @default("machine")
  locked       Boolean   @default(false)
  translatedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([specId, langCode])
  @@index([langCode])
}

// ---------------------------------------------------------------
// ÇEVİRİ ÖNBELLEĞİ
// Aynı metin bir daha çevrilmesin diye kaynak metnin özeti saklanır.
// Binlerce üründe tekrar eden etiketler tek çeviriyle karşılanır.
// ---------------------------------------------------------------

model TranslationCache {
  id       String @id @default(cuid())
  /// kaynak metnin sha256 özeti
  hash     String
  fromCode String
  toCode   String
  source   String
  target   String
  provider String @default("deepl")

  createdAt DateTime @default(now())

  @@unique([hash, fromCode, toCode])
  @@index([toCode])
}

/// Çeviri işlerinin kaydı — kaç çağrı, kaç karakter, kaç önbellek isabeti.
model TranslationRun {
  id         String    @id @default(cuid())
  langCode   String
  provider   String
  items      Int       @default(0)
  chars      Int       @default(0)
  cacheHits  Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  note       String?
}

// ---------------------------------------------------------------
// SİSTEM
// ---------------------------------------------------------------

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------
// CANLI SOHBET
// Ziyaretçi mesajları ve yönetici yanıtları. Mağaza tarafı bu
// tablolara BAĞLI DEĞİLDİR; veritabanı yoksa sohbet penceresi
// "mesaj bırak" kipine düşer, site normal çalışmayı sürdürür.
// ---------------------------------------------------------------

model ChatSession {
  id          String    @id @default(cuid())
  visitorId   String
  name        String?
  email       String?
  phone       String?
  lang        String    @default("sv")
  page        String?
  status      String    @default("open")   // open | closed
  mode        String    @default("live")   // live | offline
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  agentSeenAt DateTime?

  messages ChatMessage[]

  @@index([status, updatedAt])
  @@index([visitorId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  sender    String // visitor | agent | system
  body      String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
